ery extracted proposition to source custody, original authority, transformation, confidence, and scope. Model output can navigate evidence but cannot silently become primary authority, medical fact, legal conclusion, or Canon.\n\nThese are processing preferences, not facts, permissions, execution, Canon, legal conclusions, semantic truth, or proof of durable learning.\n","details":{"parent_model":"","format":"safetensors","family":"qwen3","families":null,"parameter_size":"8.2B","quantization_level":"int4"},"model_info":{"general.architecture":"qwen3","general.parameter_count":8190735360,"qwen3.attention.head_count":32,"qwen3.attention.head_count_kv":8,"qwen3.block_count":36,"qwen3.context_length":40960,"qwen3.embedding_length":4096,"qwen3.feed_forward_length":12288,"qwen3.vocab_size":151936},"capabilities":["completion","tools","thinking"],"modified_at":"2026-08-24T00:47:35.041046787-06:00","requires":"0.19.0"}